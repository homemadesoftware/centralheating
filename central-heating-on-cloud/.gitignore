# OpenTofu — bin/obj/.vs/.user already covered by the repo root .gitignore
infrastructure/.terraform/
infrastructure/terraform.tfvars
infrastructure/*.tfplan

# terraform.tfstate / terraform.tfstate.backup are intentionally NOT ignored
# — they're encrypted at rest (see providers.tf's `encryption` block) and
# tracked in git on purpose. Never remove the `encryption` block from
# providers.tf without re-adding these to this file first.
