// This file is shared between the AVR and x86 compilers
#ifndef HARDWARE_ABSTRACTION
#define HARDWARE_ABSTRACTION

#ifdef AVR

#define STDCALL 
#define EXPORTEDFUNCTION 
#define REENTRANT __reentrant

#else

#define STDCALL _stdcall 
#define EXPORTEDFUNCTION __declspec(dllexport) 
#define _CRT_SECURE_NO_WARNINGS
#define REENTRANT 

#endif

typedef struct tagDateTimeStruct
{
	unsigned char seconds;
	unsigned char minutes;
	unsigned char hours;
	unsigned char dayOfWeek;
	unsigned char day;
	unsigned char month;
    unsigned char year;
} DateTimeStruct;


typedef void (STDCALL *RegisterForTimerDelegate)(int cookie, int milliSeconds) REENTRANT ;
typedef void (STDCALL *EnableTimerDelegate)(int cookie, int enabled) REENTRANT ;
typedef void (STDCALL *GetRtcDelegate)(DateTimeStruct* dts) REENTRANT ;
typedef void (STDCALL *SetRtcDelegate)(DateTimeStruct* dts) REENTRANT ;
typedef void (STDCALL *WriteDisplayBufferDelegate)(unsigned char* buffer) REENTRANT ;
typedef void (STDCALL *GetKeyStateDelegate)(int* keys) REENTRANT ;
typedef void (STDCALL *GetInputPortValuesDelegate)(unsigned char *value) REENTRANT ;
typedef void (STDCALL *SetOutputPortValuesDelegate)(unsigned char value) REENTRANT ;
typedef void (STDCALL *CrashDumpDelegate)(char* buffer) REENTRANT ;
  
    

typedef struct tagHardwareInfo
{
	int TimerInterruptCookie;
	RegisterForTimerDelegate pRegisterForTimer;
    EnableTimerDelegate pEnableTimer;
	GetRtcDelegate pGetRtc;
	SetRtcDelegate pSetRtc;
	WriteDisplayBufferDelegate pWriteDisplayBuffer;
	GetKeyStateDelegate pGetKeyState;
	GetInputPortValuesDelegate pGetInputPortValues;
	SetOutputPortValuesDelegate pSetOutputPortValues;
	CrashDumpDelegate pCrashDump;
} HardwareInfo;


typedef void (STDCALL *HardwareCallDelegate)(HardwareInfo *info) REENTRANT ;


// Global delegate used for crash dumps
// Call this anytime
extern CrashDumpDelegate pCallCrashDump;


#ifdef AVR

// As defined by the HAL of AVR
void StartHardwareAbstractionOnAvr(HardwareCallDelegate pHardwareCall) REENTRANT ;

#endif

#endif
